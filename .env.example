# Browser-safe public configuration
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 公開 Persona UUID，只是訪客進入哪個 AI 分身的路徑，不是 Secret
VITE_PERSONA_ID=
# 公開頭像路徑；留空時顯示斜線佔位符
VITE_PERSONA_AVATAR_URL=

# API server only
API_HOST=127.0.0.1
PORT=8080
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
# 僅限 API server；用於後端代上傳頭像，絕不可改成 VITE_ 變數
SUPABASE_SECRET_KEY=
WEB_ORIGIN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=flying-eagle-voice-agent
LIVEKIT_WORKER_HOST=127.0.0.1
# API 與 Voice Agent 共用，至少 32 字元；絕不可放進 VITE_ 變數
VOICE_INTERNAL_TOKEN=
# API 存取 Voice Agent 內部試聽服務；本機預設 http://127.0.0.1:8082/preview
VOICE_PREVIEW_URL=
VOICE_PREVIEW_RATE_LIMIT=5

# Voice Agent only
SONIOX_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MINIMAX_API_KEY=
# 目前 MiniMax T2A 不必填；只為舊帳號／舊介面保留相容欄位
MINIMAX_GROUP_ID=
MINIMAX_API_HOST=https://api.minimax.io
MINIMAX_TTS_RUNTIME=auto
MINIMAX_TTS_WS_URL=wss://api.minimax.io/ws/v1/t2a_v2
MINIMAX_TTS_SIMPLIFIED_GLYPH=true
# 由老師為每位學員提供，只放後端環境變數，不得改成 VITE_ 變數
MINIMAX_VOICE_ID=
MINIMAX_VOICE_MODEL=speech-02-turbo
VOICE_PREVIEW_HOST=127.0.0.1
VOICE_PREVIEW_PORT=8082
SONIOX_ENABLE_SPEAKER_DIARIZATION=true
# Voice Agent 回連 Core API；正式環境必須 https://
CORE_API_URL=

# Admission control defaults are placeholders until load testing
VOICE_POWER_ON=false
VOICE_GLOBAL_CONCURRENCY_LIMIT=
VOICE_SETUP_RATE_LIMIT=
